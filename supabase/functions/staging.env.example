# Staging Edge Function secrets.
# Fill with staging/sandbox values, then apply with:
# npx --yes --cache .npx-cache-supabase supabase@latest secrets set --project-ref umvmsdwjkntcyvdcjbso --env-file supabase/functions/staging.env

SUPABASE_URL=https://umvmsdwjkntcyvdcjbso.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key

# AzamPay sandbox credentials
AZAMPAY_APP_NAME=replace-with-sandbox-app-name
AZAMPAY_CLIENT_ID=replace-with-sandbox-client-id
AZAMPAY_CLIENT_SECRET=replace-with-sandbox-client-secret
AZAMPAY_API_KEY=replace-with-sandbox-api-key

# AzamPay sandbox endpoints
AZAMPAY_AUTH_URL=https://authenticator-sandbox.azampay.co.tz/AppRegistration/GenerateToken
AZAMPAY_API_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_URL=https://sandbox.azampay.co.tz/api/v1/Partner/PostCheckout
AZAMPAY_DISBURSE_URL=https://api-disbursement-sandbox.azampay.co.tz/api/v1/azampay/disburse

# Staging callback / redirect behavior
AZAMPAY_REDIRECT_SUCCESS_URL=https://your-staging-app.example/payment-success
AZAMPAY_REDIRECT_FAIL_URL=https://your-staging-app.example/payment-failed
AZAMPAY_REQUEST_ORIGIN=https://your-staging-app.example
ORIGIN=https://your-staging-app.example

# Optional vendor fields
AZAMPAY_VENDOR_ID=
AZAMPAY_VENDOR_NAME=

# Payment settlement behavior
SETTLEMENT_HOLD_HOURS=24
