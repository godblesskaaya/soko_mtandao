SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AzamPay credentials
AZAMPAY_APP_NAME=your-app-name
AZAMPAY_CLIENT_ID=your-client-id
AZAMPAY_CLIENT_SECRET=your-client-secret

# Checkout callback authentication from AzamPay CallbackRequest.
AZAMPAY_CALLBACK_USER=your-callback-user
AZAMPAY_CALLBACK_PASSWORD=your-callback-password
AZAMPAY_CALLBACK_PUBLIC_KEY_PEM=

# Optional endpoint overrides
AZAMPAY_AUTH_URL=https://authenticator-sandbox.azampay.co.tz/AppRegistration/GenerateToken
AZAMPAY_API_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_DISBURSE_URL=https://api-disbursement-sandbox.azampay.co.tz/api/v1/azampay/disburse

# Checkout behavior
ORIGIN=https://yourapp.com
AZAMPAY_VENDOR_ID=your-vendor-id
AZAMPAY_VENDOR_NAME=your-vendor-name

# Required for AzamPay disbursement source account.
AZAMPAY_DISBURSE_SOURCE_COUNTRY_CODE=TZ
AZAMPAY_DISBURSE_SOURCE_FULL_NAME=Your Source Account Name
AZAMPAY_DISBURSE_SOURCE_BANK_NAME=tigo
AZAMPAY_DISBURSE_SOURCE_ACCOUNT_NUMBER=Your Source Account Number
AZAMPAY_DISBURSE_SOURCE_CURRENCY=TZS
AZAMPAY_DISBURSE_TRANSFER_TYPE=INTERNAL

# Payment settlement behavior
SETTLEMENT_HOLD_HOURS=24
